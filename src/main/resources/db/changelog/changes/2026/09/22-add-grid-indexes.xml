<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.10.xsd">

    <!-- Индексы под серверную пагинацию, фильтры и сортировку гридов.
         Схема таблиц создавалась вне Liquibase, поэтому у каждого индекса preCondition: если уже есть - MARK_RAN. -->
    <changeSet id="idx_orders_status_received_date" author="Emin Baghirov">
        <preConditions onFail="MARK_RAN">
            <not><indexExists indexName="idx_orders_status_received_date" tableName="orders"/></not>
        </preConditions>
        <createIndex indexName="idx_orders_status_received_date" tableName="orders">
            <column name="status"/>
            <column name="order_received_date"/>
        </createIndex>
    </changeSet>

